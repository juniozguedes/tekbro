# Tek Bro: copy to .env and adjust. Everything is optional.
# No API key needed: Tek Bro uses your logged-in Claude Code CLI (Claude Pro/Max).

TEKBRO_MODEL=sonnet          # sonnet | opus | haiku | full model id
TEKBRO_EFFORT=medium         # low | medium | high (solving the screen)
TEKBRO_ANSWER_EFFORT=low     # answering heard questions: low = fastest
TEKBRO_WHISPER_MODEL=small   # base | small | medium | large-v3
# TEKBRO_LANGUAGE=pt         # only to force a language; by default it is learned from the call
TEKBRO_SCREEN_INTERVAL=5
# TEKBRO_CALL_APP=Teams
# TEKBRO_REMOTE=1           # dashboard on your paired devices via Tailscale (see README)
# TEKBRO_HOTKEY_SOLVE=ctrl+alt+s
# TEKBRO_HOTKEY_ANSWER=ctrl+alt+a
